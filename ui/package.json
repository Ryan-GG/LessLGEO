{
  "name": "ui",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "dotenv -e ../.env.local next dev --turbopack",
    "type-check": "tsc --noEmit",
    "build": "npm run generate-sources && dotenv -e ../.env.production next build",
    "start": "npm run generate-sources && dotenv -e ../.env.production next start",
    "lint": "next lint",
    "generate-sources": "pbjs -t static-module -w commonjs -o proto-bundle.js ../modeling/src/main/proto/*.proto && pbts -o proto-bundle.d.ts proto-bundle.js",
    "test": "jest"
  },
  "dependencies": {
    "@next/env": "^15.4.4",
    "@radix-ui/react-avatar": "^1.1.10",
    "@radix-ui/react-checkbox": "^1.3.2",
    "@radix-ui/react-dropdown-menu": "^2.1.15",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-navigation-menu": "^1.2.13",
    "@react-three/drei": "^10.6.1",
    "@react-three/fiber": "^9.3.0",
    "@supabase/ssr": "^0.6.1",
    "@tanstack/react-query": "^5.84.1",
    "@types/three": "^0.178.1",
    "@vercel/analytics": "^1.5.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.525.0",
    "next": "^15.4.5",
    "next-themes": "^0.4.6",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "shadcn": "^2.9.3",
    "tailwind-merge": "^3.3.1",
    "tailwindcss-animate": "^1.0.7",
    "three": "^0.178.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10.4.21",
    "dotenv-cli": "^9.0.0",
    "eslint": "^9.32.0",
    "eslint-config-next": "15.4.4",
    "eslint-plugin-unicorn": "^60.0.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "postcss": "^8.5.6",
    "protobufjs": "^7.5.3",
    "protobufjs-cli": "^1.1.3",
    "tailwindcss": "^4.1.11",
    "ts-node": "^10.9.2",
    "tw-animate-css": "^1.3.6",
    "typescript": "^5"
  }
}
