<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <artifactId>parent</artifactId>
    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-release-plugin</artifactId>
                <version>3.3.1</version>
                <configuration>
                    <tagNameFormat>v@{project.version}</tagNameFormat>
                    <autoVersionSubmodules>true</autoVersionSubmodules>
                </configuration>
                <!-- Remove default of mvn deploy -->
                <goals />
            </plugin>
        </plugins>
    </build>
    <description>Minimize legos needed</description>
    <developers>
        <developer>
            <email>ryangross47@gmail.com</email>
            <name>Ryan Gross</name>
        </developer>
    </developers>
    <groupId>less.lgeo</groupId>
    <licenses>
        <license>
            <distribution>repo</distribution>
            <name>MIT License</name>
            <url>https://opensource.org/licenses/MIT</url>
        </license>
    </licenses>
    <modelVersion>4.0.0</modelVersion>
    <modules>
        <module>modeling</module>
        <module>parser</module>
        <module>util</module>
        <module>reducer</module>
        <module>messaging</module>
        <module>web-server</module>
        <module>database</module>
        <module>bom</module>
    </modules>
    <name>LessLGEO</name>
    <packaging>pom</packaging>
    <parent>
        <artifactId>spring-boot-starter-parent</artifactId>
        <groupId>org.springframework.boot</groupId>
        <relativePath />
        <!-- Corresponds to `spring.version` -->
        <version>3.5.6</version>
    </parent>
    <properties>
        <java.version>25</java.version>
        <maven.compiler.source>25</maven.compiler.source>
        <maven.compiler.target>25</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <spring.version>3.5.6</spring.version>
    </properties>
    <version>0.2.1-SNAPSHOT</version>
    <scm>
        <connection>scm:git:https://github.com/Ryan-GG/LessLGEO.git</connection>
        <developerConnection>scm:git:https://github.com/Ryan-GG/LessLGEO.git</developerConnection>
        <url>https://github.com/Ryan-GG/LessLGEO</url>
        <tag>HEAD</tag>
    </scm>
</project>
